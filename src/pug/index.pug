extends ./_layouts/default

block vars
  -path = "."
  -pageID = "top"
  -pageTitle = "My Website | Home"
  -pageDescription = "Welcome to our website. We provide the best services."
  -pageKeywords = "homepage, services, best"
  
  -imgPC = path+"/img/top/"
  -imgSP = path+"/img/top/sp/"
  -imgCommonPC = path+"/img/common/"
  -imgCommonSP = path+"/img/common/sp/"

block container
  .section-top-hero.decoration-common
    .wrapper 
      .section-top-hero_content 
        img.object-common(src=imgPC+"hero_img_01.png" width="992" height="987" alt="porfolio" loading="eager")
      .section-top-hero_decoration
        .section-top-hero_decoration-item.is-first 
          img.object-common(src=imgPC+"hero_img_05.png" width="184" height="183" alt="Star" loading="eager")
        .section-top-hero_decoration-item.is-second 
          img.object-common(src=imgPC+"hero_img_03.png" width="178" height="174" alt="Flower" loading="eager")
        .section-top-hero_decoration-item.is-third 
          img.object-common(src=imgPC+"hero_img_02.png" width="296" height="256" alt="Notice" loading="eager")
        .section-top-hero_decoration-item.is-fourth 
          img.object-common(src=imgPC+"hero_img_04.png" width="255" height="158" alt="Camera" loading="eager")
  .section-top-about.decoration-common
    .wrapper
      .section-top-about_detail.wow.animate__fadeInUp
        p Hiện tại, em đang theo đuổi lĩnh vực Content Marketing trong ngành F&amp;B với hơn 1 năm kinh nghiệm xây dựng nội dung trên các nền tảng số. Em tập trung vào việc phát triển hình ảnh thương hiệu, truyền tải thông điệp một cách nhất quán và nâng cao trải nghiệm khách hàng thông qua nội dung sáng tạo.
        p Xuất phát từ nền tảng Du lịch &amp; Khách sạn tại Đại học Duy Tân, em sở hữu tư duy dịch vụ cùng khả năng thấu hiểu khách hàng, từ đó ứng dụng hiệu quả vào quá trình làm marketing. Bên cạnh đó, em cũng được đào tạo về content đa kênh, chiến lược nội dung và nhận diện thương hiệu, với định hướng phát triển trở thành một Marketer có tư duy chiến lược và khả năng khai thác insight thông qua nội dung.
      .section-top-about_image.wow.animate__fadeInUp(data-wow-delay="0.5s")
        figure.section-top-about_image-wrapper
          img.object-common(src=imgPC+"about_img_01.jpg" width="496" height="496" alt="Diem Quynh" loading="lazy")
        p.section-top-about_image-description Diễm Quỳnh