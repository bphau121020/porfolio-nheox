include ../_parts/breadcrumb

//- Mixin for WebP Image Optimization
//- Usage: +image('img/hero.jpg', 'Hero Image', 'hero-class')
mixin image(src, alt='', className='')
  //- Extract the path without extension, and the extension
  - var srcArr = src.split('.')
  - var ext = srcArr.pop()
  - var pathWithoutExt = srcArr.join('.')
  
  picture
    source(srcset=pathWithoutExt + '.webp', type='image/webp')
    img(src=src, alt=alt, class=className, loading="lazy", decoding="async")
