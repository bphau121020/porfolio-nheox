{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ES2015",
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jquery"],
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": true
  },
  "include": ["src/ts/*"],
  "exclude": ["node_modules", "dist"]
}
